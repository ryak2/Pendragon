<section class="tab combat {{tab.cssClass}}" data-group="primary" data-tab="combat">
<div class="combat-grid">
  <div>
    <ol class="trait-grid2">
    {{#each traits as |trait key|}}
      <li data-itemid="{{trait._id}}">
        <span class="right {{#if (gt trait.system.total 15)}}famous{{/if}} {{#if (gt trait.system.total 20)}}exalted{{/if}}">{{trait.system.total}}</span>
        <span class="trait right {{#if (gt trait.system.religious 0)}}religious {{/if}}{{#if (gt trait.system.total 15)}}famous{{/if}} {{#if (gt trait.system.total 20)}}exalted{{/if}}" data-type ="trait" data-itemid="{{trait._id}}" data-action="rollTrait">{{trait.name}}</span>
        <span data-action="rollDecision"><i class="fa-regular fa-scale-balanced"></i></span>
        <span class="trait {{#if (lt trait.system.religious 0)}}religious {{/if}}{{#if (gt trait.system.oppvalue 15)}}famous{{/if}} {{#if (gt trait.system.oppvalue 20)}}exalted{{/if}}" data-type ="opptrait" data-itemid="{{trait._id}}" data-action="rollTrait">{{trait.system.oppName}}</span>
        <span class="right {{#if (gt trait.system.oppvalue 15)}}famous{{/if}} {{#if (gt trait.system.oppvalue 20)}}exalted{{/if}}">{{trait.system.oppvalue}}</span>
      </li>
    {{/each}}
    </ol>
  </div>


  <div>
    <div style="display: grid;gap: 0.5rem;grid-template-columns: 1fr 120px 1fr;align-items:stretch;">
      <div style="border-radius: 0.25rem;padding: 0.5rem;background-color: var(--pd-light-row);">
        {{#if currentHorse}}
        <p><i class= "fa-solid fa-horse-head"></i>{{currentHorse.name}}</p>
        <p>{{currentHorse.classification}}{{#if currentHorse.system.combat}} - {{localize 'PEN.warTrained'}}{{/if}}</p>
        <p>{{localize 'PEN.hp'}}: {{currentHorse.system.hp}} / {{currentHorse.system.maxHP}}</p>
        <p>{{localize 'PEN.move'}}: {{currentHorse.system.move}} / {{localize 'PEN.knockdown'}}: {{currentHorse.system.siz}}</p>
        {{/if}}
        <button type="button" data-action="switchHorse">{{localize 'PEN.changeHorse'}}</button>
        <label class="condition">
        <input type="checkbox" {{#if statuses.mounted.active}}checked{{/if}} disabled/>
        <img src="{{statuses.mounted.img}}" class="icon-img" />
        <span>{{ statuses.mounted.name }}</span>
        </label>
      </div>
      <div>
        <p>{{localize 'PEN.knockdown'}}: {{system.hp.knockdown}}</p>
        <p>{{localize 'PEN.mjrWnd'}}: {{system.hp.majorWnd}}</p>
        <p>{{localize 'PEN.unconscious'}}: {{system.hp.unconscious}}</p>
        <p style="font-weight: bold;font-size:larger"><i class= "fa-solid fa-swords"></i> {{localize 'PEN.held'}}</p>
        {{#if system.equippedHands.primary}}
          {{#if (eq system.equippedHands.primary system.equippedHands.secondary)}}
            <p><i class="fa-solid fa-hand-fist"></i> {{localize 'PEN.wield.twoHanded'}}: {{primaryHandItem.name}} {{primaryHandItem.system.total}}
            </p>
            <p>{{localize 'PEN.damage'}}: {{primaryHandItem.system.damage}}</p>
          {{else}}
            {{#if primaryHandItem}}
              <p><i class="fa-solid fa-sword"></i> {{localize 'PEN.wield.primaryHand'}}: {{primaryHandItem.name}} {{primaryHandItem.system.total}}
              </p>
              <p>{{localize 'PEN.damage'}}: {{primaryHandItem.system.damage}}</p>
            {{/if}}
            {{#if secondaryHandItem}}
              <p><i class="fa-solid fa-shield"></i> {{localize 'PEN.secondaryHand'}}: {{secondaryHandItem.name}}{{#if (eq secondaryHandItem.type 'armour')}} ({{secondaryHandItem.system.ap}}){{/if}}
              </p>
            {{/if}}
            {{#if secondaryHandItem}}
              {{#unless (eq secondaryHandItem.type 'armour')}}
                <p>{{localize 'PEN.damage'}}: {{secondaryHandItem.system.damage}}</p>
              {{/unless}}
            {{/if}}
          {{/if}}
        {{else}}
          <p>{{currentWeapon.name}} {{currentWeapon.total}}</p>
          <p>{{localize 'PEN.damage'}}: {{currentWeapon.damage}}</p>
        {{/if}}
        <button type="button" data-action="goToEquipment">{{localize 'PEN.changeWeapon'}}</button>
      </div>
      <div style="border-radius: 0.25rem;padding: 0.5rem;background-color: var(--pd-light-row);">
        <p>{{localize 'PEN.armourPoints'}}: {{system.armour}} + {{shield}} <i class="fa-solid fa-shield"></i></p>
        <p>{{localize 'PEN.move'}}: {{system.move}}</p>
        <label class="condition">
        <input type="checkbox" {{#if statuses.debilitated.active}}checked{{/if}} disabled/>
        <img src="{{statuses.debilitated.img}}" class="icon-img" />
        <span>{{ statuses.debilitated.name }}</span>
        </label>
        <label class="condition">
        <input type="checkbox" {{#if statuses.unconscious.active}}checked{{/if}} disabled/>
        <img src="{{statuses.unconscious.img}}" class="icon-img" />
        <span>{{ statuses.unconscious.name }}</span>
        </label>
        <label class="condition">
        <input type="checkbox" {{#if statuses.dying.active}}checked{{/if}} disabled/>
        <img src="{{statuses.dying.img}}" class="icon-img" />
        <span>{{ statuses.dying.name }}</span>
        </label>
        <button type="button" data-action="showWounds">{{localize 'PEN.woundsHealing'}}</button>
      </div>
    </div>
    <h2>{{localize 'PEN.combatActions.title'}}</h2>
    <div class="actions">
      <button type="button" data-action="combatAction" data-combat-action="attack">{{localize 'PEN.combatActions.attack'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="reckless">{{localize 'PEN.combatActions.reckless'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="callSquire">{{localize 'PEN.combatActions.callSquire'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="claimPrisoner">{{localize 'PEN.combatActions.claimPrisoner'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="defend">{{localize 'PEN.combatActions.defend'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="disarm">{{localize 'PEN.combatActions.disarm'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="evade">{{localize 'PEN.combatActions.evade'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="pickUp">{{localize 'PEN.combatActions.pickUp'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="selfSacrifice">{{localize 'PEN.combatActions.selfSacrifice'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="study">{{localize 'PEN.combatActions.study'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="withholdDamage">{{localize 'PEN.combatActions.withholdDamage'}}</button>
      <button type="button" data-action="combatAction" data-combat-action="zigzag">{{localize 'PEN.combatActions.zigzag'}}</button>
    </div>
    <div class="action-tabs">
      <details name="cond-actions" {{#if statuses.mounted.active}}open{{/if}}>
        <summary>{{localize 'PEN.mounted'}}</summary>
        <div class="actions">
        <button type="button" data-action="combatAction" data-combat-action="charge">{{localize 'PEN.combatActions.charge'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="controlMount">{{localize 'PEN.combatActions.controlMount'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="trample">{{localize 'PEN.combatActions.trample'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="dismount">{{localize 'PEN.combatActions.dismount'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="quickDismount">{{localize 'PEN.combatActions.quickDismount'}}</button>
        </div>
      </details>
      <details name="cond-actions" {{#unless statuses.mounted.active}}open{{/unless}}>
        <summary>{{localize 'PEN.combatActions.onFoot'}}</summary>
        <div class="actions">
        <button type="button" data-action="combatAction" data-combat-action="dodge">{{localize 'PEN.combatActions.dodge'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="donArmor">{{localize 'PEN.combatActions.donArmor'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="hook">{{localize 'PEN.combatActions.hook'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="setSpear">{{localize 'PEN.combatActions.setSpear'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="mount">{{localize 'PEN.combatActions.leap'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="mount">{{localize 'PEN.combatActions.mount'}}</button>
        </div>
      </details>
      <details name="cond-actions">
        <summary>{{localize 'PEN.combatActions.brawling'}}</summary>
        <div class="actions">
        <button type="button" data-action="combatAction" data-combat-action="punch">{{localize 'PEN.combatActions.punch'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="slap">{{localize 'PEN.combatActions.slap'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="escape">{{localize 'PEN.combatActions.escape'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="grapple">{{localize 'PEN.combatActions.grapple'}}</button>
        <button type="button" data-action="combatAction" data-combat-action="slam">{{localize 'PEN.combatActions.slam'}}</button>
        </div>
      </details>
      <details name="cond-actions">
        <summary>{{localize 'PEN.combatActions.battle'}}</summary>
        <div class="actions">
          <label>{{localize 'PEN.battlePosture'}}</label>
          <select class="centre" data-handle-change name="system.battlePos">
            {{selectOptions battlePosType selected=system.battlePos}}
          </select>
          <label>{{localize 'PEN.fieldPosition'}}</label>
          <select class="centre" data-handle-change name="system.fieldPos">
            {{selectOptions fieldPosType selected=system.fieldPos}}
          </select>
        </div>
      </details>
    </div>
  </div>
</div>
</section>
